  <diagram name="Page-1" id="EEoHg986AZFSuiPJeWod">
    <mxGraphModel dx="2575" dy="-395" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Role {\n        +int roleId\n        +String roleName\n        +String description\n        +assignRole()\n        +updateRole()\n    }\n\n    class User {\n        +int userId\n        +String username\n        +String passwordHash\n        +String email\n        +String phone\n        +DateTime createdAt\n        +String status\n        +login()\n        +logout()\n        +changePassword()\n        +updateProfile()\n    }\n\n    class Customer {\n        +int customerId\n        +String nic\n        +String address\n        +Date dateOfBirth\n        +viewAccounts()\n        +transferFunds()\n        +applyLoan()\n        +payBills()\n        +manageBeneficiaries()\n    }\n\n    class Employee {\n        +int employeeId\n        +String department\n        +String position\n        +Date dateJoined\n        +verifyCustomer()\n        +reviewLoan()\n        +reviewTransaction()\n    }\n\n    class Manager {\n        +approveLoan()\n        +generateReport()\n        +manageEmployees()\n    }\n\n    class Account {\n        +int accountId\n        +String accountNumber\n        +String accountType\n        +Decimal balance\n        +Date openDate\n        +String status\n        +deposit()\n        +withdraw()\n        +getBalance()\n    }\n\n    class Transaction {\n        +int transactionId\n        +Decimal amount\n        +String transactionType\n        +String status\n        +String description\n        +DateTime createdAt\n        +DateTime completedAt\n        +initiateTransfer()\n        +verifyOTP()\n        +completeTransfer()\n        +generateReceipt()\n    }\n\n    class OTP {\n        +int otpId\n        +String otpCode\n        +DateTime createdAt\n        +DateTime expiresAt\n        +Boolean verified\n        +DateTime verifiedAt\n        +generateOTP()\n        +verifyOTP()\n        +expireOTP()\n    }\n\n    class Beneficiary {\n        +int beneficiaryId\n        +String name\n        +String accountNumber\n        +String bankName\n        +String relationship\n        +addBeneficiary()\n        +removeBeneficiary()\n        +updateBeneficiary()\n    }\n\n    class Loan {\n        +int loanId\n        +String loanType\n        +Decimal amount\n        +Decimal interestRate\n        +String status\n        +Date applyDate\n        +Date reviewDate\n        +applyLoan()\n        +approveLoan()\n        +rejectLoan()\n        +viewStatus()\n    }\n\n    class BillPayment {\n        +int paymentId\n        +String billType\n        +String referenceNumber\n        +Decimal amount\n        +Date paymentDate\n        +String status\n        +payBill()\n        +viewReceipt()\n    }\n\n    class Card {\n        +int cardId\n        +String cardNumber\n        +String cardType\n        +Date expiryDate\n        +String status\n        +activateCard()\n        +blockCard()\n        +viewCardDetails()\n    }\n\n    class Feedback {\n        +int feedbackId\n        +String subject\n        +String message\n        +String status\n        +DateTime createdAt\n        +submitFeedback()\n        +updateFeedback()\n    }\n\n    class Notification {\n        +int notificationId\n        +String title\n        +String message\n        +String status\n        +DateTime createdAt\n        +sendNotification()\n        +markAsRead()\n    }\n\n    class AuditLog {\n        +int logId\n        +String action\n        +String entityType\n        +int entityId\n        +DateTime performedAt\n        +String ipAddress\n        +recordAction()\n        +viewLog()\n    }\n\n    %% Inheritance\n    User &lt;|-- Customer\n    User &lt;|-- Employee\n    Employee &lt;|-- Manager\n\n    %% Associations\n    Role \&quot;1\&quot; -- \&quot;*\&quot; User\n    Customer \&quot;1\&quot; -- \&quot;*\&quot; Account\n    Customer \&quot;1\&quot; -- \&quot;*\&quot; Beneficiary\n    Customer \&quot;1\&quot; -- \&quot;*\&quot; Loan\n    Customer \&quot;1\&quot; -- \&quot;*\&quot; BillPayment\n    Customer \&quot;1\&quot; -- \&quot;*\&quot; Feedback\n    Account \&quot;1\&quot; -- \&quot;*\&quot; Transaction\n    Account \&quot;1\&quot; -- \&quot;*\&quot; Card\n    Transaction \&quot;1\&quot; -- \&quot;1\&quot; OTP\n    User \&quot;1\&quot; -- \&quot;*\&quot; Notification\n    User \&quot;1\&quot; -- \&quot;*\&quot; AuditLog\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4_i27LM_PfzX7JROOJXc-379">
