<mxfile host="Electron">
  <diagram name="Page-1" id="Edz75aM9oUrS-spw7ep6">
    <mxGraphModel dx="4120" dy="2888" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Top Hierarchy Relationships\n    ROLE ||--o{ USER : \&quot;assigned to\&quot;\n    USER ||--o| CUSTOMER : \&quot;is a\&quot;\n    USER ||--o| EMPLOYEE : \&quot;is a\&quot;\n\n    %% Customer Domain Relationships\n    CUSTOMER ||--o{ ACCOUNT : \&quot;owns\&quot;\n    CUSTOMER ||--o{ BENEFICIARY : \&quot;manages\&quot;\n    CUSTOMER ||--o{ LOAN : \&quot;applies for\&quot;\n    CUSTOMER ||--o{ FEEDBACK : \&quot;submits\&quot;\n    CUSTOMER ||--o{ BILL_PAYMENT : \&quot;initiates\&quot;\n    CUSTOMER ||--o{ AI_CHAT : \&quot;interacts via\&quot;\n\n    %% Banking Core Relationships\n    ACCOUNT ||--o{ TRANSACTION : \&quot;involved in\&quot;\n    ACCOUNT ||--o{ CARD : \&quot;issued for\&quot;\n    ACCOUNT ||--o{ BILL_PAYMENT : \&quot;debited for\&quot;\n    TRANSACTION ||--|| OTP : \&quot;authenticated by\&quot;\n\n    %% Employee Domain Relationships\n    EMPLOYEE ||--o{ LOAN : \&quot;reviews\&quot;\n\n    %% System &amp; AI Domain Relationships\n    USER ||--o{ NOTIFICATION : \&quot;receives\&quot;\n    USER ||--o{ AUDIT_LOG : \&quot;triggers\&quot;\n    AI_ASSISTANT ||--o{ AI_CHAT : \&quot;handles\&quot;\n\n    %% Entity Definitions\n    ROLE {\n        int role_id PK\n        string role_name\n        string description\n    }\n\n    USER {\n        int user_id PK\n        int role_id FK\n        string username\n        string password_hash\n        string email\n        string phone\n        string status\n        datetime created_at\n    }\n\n    CUSTOMER {\n        int customer_id PK\n        int user_id FK\n        string nic\n        string address\n        date date_of_birth\n    }\n\n    EMPLOYEE {\n        int employee_id PK\n        int user_id FK\n        string department\n        string position\n        date date_joined\n    }\n\n    ACCOUNT {\n        int account_id PK\n        int customer_id FK\n        string account_number\n        string account_type\n        decimal balance\n        date open_date\n        string status\n    }\n\n    BENEFICIARY {\n        int beneficiary_id PK\n        int customer_id FK\n        string name\n        string account_number\n        string bank_name\n        string relationship\n    }\n\n    TRANSACTION {\n        int transaction_id PK\n        int from_account_id FK\n        int to_account_id FK\n        int otp_id FK\n        decimal amount\n        string transaction_type\n        string status\n        string description\n        datetime created_at\n        datetime completed_at\n    }\n\n    OTP {\n        int otp_id PK\n        int transaction_id FK\n        string otp_code\n        datetime created_at\n        datetime expires_at\n        boolean verified\n        datetime verified_at\n    }\n\n    LOAN {\n        int loan_id PK\n        int customer_id FK\n        int reviewer_employee_id FK\n        string loan_type\n        decimal amount\n        decimal interest_rate\n        string status\n        date apply_date\n        date review_date\n    }\n\n    BILL_PAYMENT {\n        int payment_id PK\n        int customer_id FK\n        int account_id FK\n        string reference_number\n        string bill_type\n        decimal amount\n        date payment_date\n        string status\n    }\n\n    CARD {\n        int card_id PK\n        int account_id FK\n        string card_number\n        string card_type\n        date expiry_date\n        string status\n    }\n\n    FEEDBACK {\n        int feedback_id PK\n        int customer_id FK\n        string subject\n        string message\n        string status\n        datetime created_at\n    }\n\n    NOTIFICATION {\n        int notification_id PK\n        int user_id FK\n        string title\n        string message\n        string status\n        datetime created_at\n    }\n\n    AUDIT_LOG {\n        int log_id PK\n        int user_id FK\n        string action\n        string entity_type\n        int entity_id\n        datetime performed_at\n        string ip_address\n    }\n\n    AI_ASSISTANT {\n        int assistant_id PK\n        string name\n        string version\n        string status\n    }\n\n    AI_CHAT {\n        int chat_id PK\n        int customer_id FK\n        int assistant_id FK\n        string question\n        string response\n        datetime created_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_Jhx2fYVEzF_hhUlj6hj-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
