        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% Color Schemes\n    classDef custActor fill:#0050ef,stroke:#002060,color:#fff,font-weight:bold;\n    classDef staffActor fill:#d8721c,stroke:#a0522d,color:#fff,font-weight:bold;\n    classDef adminActor fill:#6a00ff,stroke:#3700b3,color:#fff,font-weight:bold;\n\n    classDef custUC fill:#0f3818,stroke:#4caf50,color:#fff,stroke-width:2px;\n    classDef custSubUC fill:#0b2b13,stroke:#2e7d32,color:#dddddd,stroke-width:1px;\n    classDef staffUC fill:#3a2203,stroke:#ff9800,color:#fff,stroke-width:2px;\n    classDef adminUC fill:#2d0b38,stroke:#ab47bc,color:#fff,stroke-width:2px;\n\n    %% Actors\n    Customer[\&quot;👤 Customer\&quot;]:::custActor\n    Employee[\&quot;👤 Employee\&quot;]:::staffActor\n    Manager[\&quot;👤 Manager\&quot;]:::staffActor\n    Admin[\&quot;👤 Admin\&quot;]:::adminActor\n\n    %% Actor Relationships\n    Manager --&gt;|extends| Employee\n\n    %% System Boundary\n    subgraph System [\&quot;Banking Application System\&quot;]\n        \n        subgraph CustGroup [\&quot;Customer Services\&quot;]\n            UC_Login([\&quot;Login\&quot;]):::custUC\n            UC_ViewAcc([\&quot;View Accounts\&quot;]):::custUC\n            UC_ViewTxn([\&quot;View Transactions\&quot;]):::custUC\n            UC_Transfer([\&quot;Transfer Money\&quot;]):::custUC\n            UC_Beneficiaries([\&quot;Manage Beneficiaries\&quot;]):::custUC\n            UC_ApplyLoan([\&quot;Apply Loan\&quot;]):::custUC\n            UC_PayBills([\&quot;Pay Bills\&quot;]):::custUC\n            UC_Cards([\&quot;Manage Cards\&quot;]):::custUC\n            UC_ATM([\&quot;ATM Simulation\&quot;]):::custUC\n            UC_Feedback([\&quot;Submit Feedback\&quot;]):::custUC\n            UC_AIChat([\&quot;Chat with AI\&quot;]):::custUC\n\n            UC_OTP([\&quot;OTP Verification\&quot;]):::custSubUC\n            UC_IntTransfer([\&quot;Internal Transfer\&quot;]):::custSubUC\n            UC_ExtTransfer([\&quot;Interbank Transfer\&quot;]):::custSubUC\n        end\n\n        subgraph StaffGroup [\&quot;Staff &amp; Operational Management\&quot;]\n            UC_MgmtCust([\&quot;Manage Customers\&quot;]):::staffUC\n            UC_RevLoans([\&quot;Review Loans\&quot;]):::staffUC\n            UC_RevTxn([\&quot;Review Transactions\&quot;]):::staffUC\n            UC_AppLoans([\&quot;Approve Loans\&quot;]):::staffUC\n            UC_AppHVTxn([\&quot;Approve High Value Txns\&quot;]):::staffUC\n            UC_GenReports([\&quot;Generate Reports\&quot;]):::staffUC\n            UC_MgmtEmp([\&quot;Manage Employees\&quot;]):::staffUC\n        end\n\n        subgraph AdminGroup [\&quot;System Administration\&quot;]\n            UC_MgmtUsers([\&quot;Manage Users\&quot;]):::adminUC\n            UC_MgmtRoles([\&quot;Manage Roles\&quot;]):::adminUC\n            UC_AuditLogs([\&quot;View Audit Logs\&quot;]):::adminUC\n        end\n    end\n\n    %% Customer Connections\n    Customer --&gt; UC_Login\n    Customer --&gt; UC_ViewAcc\n    Customer --&gt; UC_ViewTxn\n    Customer --&gt; UC_Transfer\n    Customer --&gt; UC_Beneficiaries\n    Customer --&gt; UC_ApplyLoan\n    Customer --&gt; UC_PayBills\n    Customer --&gt; UC_Cards\n    Customer --&gt; UC_ATM\n    Customer --&gt; UC_Feedback\n    Customer --&gt; UC_AIChat\n    Customer --&gt; UC_IntTransfer\n    Customer --&gt; UC_ExtTransfer\n\n    UC_Transfer -.-&gt;|include| UC_OTP\n\n    %% Employee Connections\n    Employee --&gt; UC_MgmtCust\n    Employee --&gt; UC_RevLoans\n    Employee --&gt; UC_RevTxn\n\n    %% Manager Connections\n    Manager --&gt; UC_AppLoans\n    Manager --&gt; UC_AppHVTxn\n    Manager --&gt; UC_GenReports\n    Manager --&gt; UC_MgmtEmp\n\n    %% Admin Connections\n    Admin --&gt; UC_MgmtUsers\n    Admin --&gt; UC_MgmtRoles\n    Admin --&gt; UC_AuditLogs&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="I0sE_r54C47Byo2voztb-59">
