  <diagram name="Page-1" id="PeAP_NYZZxU7lii7JvUC">
    <mxGraphModel dx="2943" dy="2063" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!pragma layout smetana\nskinparam packageStyle rectangle\nskinparam componentStyle rectangle\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam RoundCorner 10\n\n&#39; Styles\nskinparam package {\n    BackgroundColor&lt;&lt;Users&gt;&gt; #E3F2FD\n    BorderColor&lt;&lt;Users&gt;&gt; #1565C0\n    BackgroundColor&lt;&lt;Presentation&gt;&gt; #E8F5E9\n    BorderColor&lt;&lt;Presentation&gt;&gt; #2E7D32\n    BackgroundColor&lt;&lt;Business&gt;&gt; #FFF3E0\n    BorderColor&lt;&lt;Business&gt;&gt; #E65100\n    BackgroundColor&lt;&lt;External&gt;&gt; #F3E5F5\n    BorderColor&lt;&lt;External&gt;&gt; #6A1B9A\n    BackgroundColor&lt;&lt;Data&gt;&gt; #ECEFF1\n    BorderColor&lt;&lt;Data&gt;&gt; #37474F\n}\n\npackage \&quot;LEVEL 1: USERS\&quot; &lt;&lt;Users&gt;&gt; {\n    actor \&quot;Customer\&quot; as u_cust\n    actor \&quot;Bank Employee\&quot; as u_emp\n    actor \&quot;Branch Manager\&quot; as u_mgr\n    actor \&quot;System Administrator\&quot; as u_admin\n}\n\npackage \&quot;LEVEL 2: PRESENTATION LAYER (CLIENT)\&quot; &lt;&lt;Presentation&gt;&gt; {\n    node \&quot;Web Browser\&quot; {\n        component \&quot;React + TypeScript Frontend\&quot; as ReactFE {\n            component \&quot;Login\&quot; as f_login\n            component \&quot;Account Dashboard\&quot; as f_acc\n            component \&quot;Transaction Dashboard\&quot; as f_txn\n            component \&quot;Loan Portal\&quot; as f_loan\n            component \&quot;Bill Payment Portal\&quot; as f_bill\n            component \&quot;Card Management Portal\&quot; as f_card\n            component \&quot;AI Assistant Chat Interface\&quot; as f_ai\n            component \&quot;Admin Dashboard\&quot; as f_admin\n        }\n    }\n}\n\npackage \&quot;LEVEL 3: BUSINESS LAYER (APPLICATION SERVER)\&quot; &lt;&lt;Business&gt;&gt; {\n    node \&quot;Spring Boot Application Server\&quot; as SpringBackend {\n        component \&quot;1. Auth Service (JWT &amp; RBAC)\&quot; as s_auth\n        component \&quot;2. User Management Service\&quot; as s_user\n        component \&quot;3. Account Management Service\&quot; as s_acc\n        component \&quot;4. Fund Transfer Service\&quot; as s_transfer\n        component \&quot;5. OTP Verification Service\&quot; as s_otp_v\n        component \&quot;6. Beneficiary Management Service\&quot; as s_ben\n        component \&quot;7. Transaction Management Service\&quot; as s_txn\n        component \&quot;8. Loan Management Service\&quot; as s_loan\n        component \&quot;9. Bill Payment Service\&quot; as s_bill\n        component \&quot;10. Card Management Service\&quot; as s_card\n        component \&quot;11. Feedback Management Service\&quot; as s_feed\n        component \&quot;12. Report Management Service\&quot; as s_report\n        component \&quot;13. Notification Service\&quot; as s_notif\n        component \&quot;14. AI Assistant Service\&quot; as s_ai\n    }\n}\n\npackage \&quot;LEVEL 4: INTEGRATION LAYER / EXTERNAL SERVICES\&quot; &lt;&lt;External&gt;&gt; {\n    component \&quot;OTP Service\\n• Generate OTP\\n• Validate OTP\&quot; as ext_otp\n    component \&quot;Notification Gateway\\n• Email Notifications\\n• SMS Alerts\&quot; as ext_notif\n    component \&quot;AI Engine\\n• Banking FAQ Support\\n• Loan Guidance\\n• Navigation Assistance\&quot; as ext_ai\n}\n\npackage \&quot;LEVEL 5: DATA LAYER\&quot; &lt;&lt;Data&gt;&gt; {\n    database \&quot;PostgreSQL Database\&quot; as DB {\n        folder \&quot;Tables\&quot; {\n            [Role | User | Customer | Employee]\n            [Account | Transaction | OTP | Beneficiary]\n            [Loan | BillPayment | Card | Feedback]\n            [Notification | AuditLog]\n        }\n    }\n}\n\n&#39; Data Flow &amp; Connections\nu_cust --&gt; ReactFE : Access\nu_emp --&gt; ReactFE : Access\nu_mgr --&gt; ReactFE : Access\nu_admin --&gt; ReactFE : Access\n\nReactFE --&gt; SpringBackend : REST API Calls (HTTPS / JSON)\n\nSpringBackend --&gt; DB : Read / Write\n\n&#39; Specific Service Interactions\ns_transfer --&gt; ext_otp : 1. Requests OTP\next_otp --&gt; s_otp_v : 2. Response\ns_notif --&gt; ext_notif : Dispatches Email/SMS\ns_ai --&gt; ext_ai : Integrates AI Engine\n\ns_loan --&gt; s_report : Generates Loan Reports\ns_report ..&gt; f_admin : View Reports (Manager Dashboard)\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-c0F2BWSkiQS4Gg6cY6X-1">
